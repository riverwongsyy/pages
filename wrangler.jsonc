{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pages",
  "main": "functions/index.ts",
  "compatibility_date": "2024-09-23",
  "assets": {
    "directory": "./dist"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "navigation-db-local",
      "database_id": "navigation-db-local"
    }
  ],
  "observability": {
    "enabled": true
  }
}
